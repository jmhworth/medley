# Spotify Developer Dashboard → Create app → copy Client ID
# https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=

# Must match a Redirect URI registered on the Spotify app exactly
# Include Next.js's dev-server port, and use this same host when opening Medley.
# Example for local Next.js: http://127.0.0.1:3000/api/spotify/callback
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/spotify/callback

# Shared personal Supabase project. Values are owned by this project's ignored `.env`.
# Prefer SUPABASE_PUBLISHABLE_KEY + SUPABASE_SECRET_KEY (anon/service_role and
# SUPABASE_PRIVATE_KEY remain accepted aliases). Project ref is optional when
# SUPABASE_URL is https://<project-ref>.supabase.co.
# Do not put real credentials here; set them in this project's ignored `.env`.
# Database access for Activate / migration push (set at least one in this project's `.env`):
# Optional IPv4 connection; use the Supabase Session pooler URL.
# Optional IPv6 connection; use the Supabase direct connection URL.

# Shared personal Supabase project. Values are owned by this project's ignored `.env`.
# Prefer SUPABASE_PUBLISHABLE_KEY + SUPABASE_SECRET_KEY (anon/service_role and
# SUPABASE_PRIVATE_KEY remain accepted aliases). Project ref is optional when
# SUPABASE_URL is https://<project-ref>.supabase.co.
# Do not put real credentials here; set them in this project's ignored `.env`.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Optional when SUPABASE_URL is https://<project-ref>.supabase.co:
SUPABASE_PROJECT_REF=
# Database access for Activate / migration push (set at least one in this project's `.env`):
SUPABASE_DB_URL=
# Optional IPv4 connection; use the Supabase Session pooler URL.
SUPABASE_DB_URL_IPV4=
# Optional IPv6 connection; use the Supabase direct connection URL.
SUPABASE_DB_URL_IPV6=
SUPABASE_ACCESS_TOKEN=

# Project-specific Postgres schema on the shared database (never use public).
SUPABASE_SCHEMA=medley

# After migrations apply, allow-list schema "medley" in Supabase Dashboard → Project Settings → Data API (PostgREST exposed schemas).
